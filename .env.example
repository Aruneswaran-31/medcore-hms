# ─────────────────────────────────────────────────────────────
# MedCore HMS — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database (PostgreSQL 16) ─────────────────────────────────
DATABASE_URL=postgresql://medcore:medcore_password@localhost:5432/medcore?schema=public

# ── Redis 7 (sessions, cache, rate limiting) ─────────────────
# Leave empty to fall back to the in-memory adapter (dev only).
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────
# 256-bit (32 byte) random secret, hex encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_min_32_bytes_random
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_bytes_random
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_COST=12
# Comma separated list of origins allowed to call the API (CORS allow-list)
CORS_ORIGINS=http://localhost:3000

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── File storage (S3 / Cloudinary compatible) ────────────────
S3_ENDPOINT=
S3_BUCKET=medcore-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Payments (test mode only) ────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email (Resend) / SMS (Twilio) ────────────────────────────
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Observability ────────────────────────────────────────────
SENTRY_DSN=